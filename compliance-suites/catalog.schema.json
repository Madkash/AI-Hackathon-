{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "localproof://schemas/compliance-suite-catalog-v1",
  "title": "LocalProof compliance suite catalog",
  "type": "object",
  "required": ["suite", "version", "sources", "tests"],
  "properties": {
    "suite": {
      "enum": ["soc2", "iso27001", "security", "wcag"]
    },
    "version": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "disclaimer": { "type": "string" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "url"],
        "properties": {
          "name": { "type": "string" },
          "version": { "type": ["string", "null"] },
          "url": { "type": "string" },
          "retrieved": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "control": { "type": ["string", "null"] },
          "category": { "type": ["string", "null"] },
          "type": { "type": ["string", "null"] },
          "automation": {
            "enum": ["automated", "assisted", "manual", null]
          },
          "safety": {
            "enum": ["passive", "safe-active", "intrusive", null]
          },
          "applicability": { "type": ["string", "array", "null"] },
          "inputs": { "type": ["array", "object", "string", "null"] },
          "local_tool": { "type": ["string", "null"] },
          "expected_evidence": { "type": ["array", "string", "null"] },
          "limitations": { "type": ["array", "string", "null"] },
          "executor": {
            "type": ["object", "null"],
            "properties": {
              "handler": {
                "enum": ["file-presence", "source-pattern", "local-http", "local-command", "manual", "unimplemented"]
              },
              "config": { "type": "object" }
            },
            "required": ["handler"],
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
